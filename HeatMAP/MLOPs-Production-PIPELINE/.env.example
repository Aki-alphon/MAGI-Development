# MAGI Vision Environment Variables
# ====================================
# Copy to .env and fill in values

# Dataset source (optional — defaults to local data/ directory)
# MAGI_DATASET_PATH=/path/to/your/dataset

# Kaggle API (required only for automatic dataset download)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Override default Kaggle dataset
# MAGI_KAGGLE_DATASET=vipoooool/new-plant-diseases-dataset

      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.006 0.0 -0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.0183 0.036 0.0375"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.008"/>

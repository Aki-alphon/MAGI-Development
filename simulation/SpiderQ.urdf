  </joint>

  <link name="coxa_link_2">
    <visual>
      <origin xyz="-0.011 0.0 0.006" rpy="0.7854 0 0"/>
      <geometry>
        <box size="0.0183 0.036 0.0375"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.011 0.0 0.006" rpy="0 0 0"/>

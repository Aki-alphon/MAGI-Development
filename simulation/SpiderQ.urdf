      <inertia ixx="1.5e-6" ixy="0" ixz="0"
               iyy="1.5e-6" iyz="0"
               izz="1.5e-6"/>
    </inertial>
  </link>

  <joint name="tibia_joint_1" type="revolute">
    <parent link="femur_link_1"/>
    <child  link="tibia_link_1"/>
    <origin xyz="0.028 -0.0005 -0.036" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="-2.0944" upper="0.1745" effort="1.8" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="tibia_link_1">
    <visual>
      <origin xyz="0.050 0.0 -0.020" rpy="0 -0.7854 0"/>
      <geometry>
        <box size="0.0183 0.0165 0.1003"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.050 0.0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.0183 0.0165 0.1003"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.0e-6" ixy="0" ixz="0"
               iyy="8.0e-6" iyz="0"
               izz="8.0e-6"/>
    </inertial>
  </link>

  <joint name="foot_joint_1" type="fixed">
    <parent link="tibia_link_1"/>
    <child  link="foot_link_1"/>
    <origin xyz="0.090 0.0 -0.020" rpy="0 0 0"/>
  </joint>
  <link name="foot_link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.002"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>

  <!-- ===========================================================
       LEG 2  —  Rear-Left    coxa-pivot at (-0.050, 0.077, 0.041)
  =========================================================== -->

  <joint name="coxa_joint_2" type="revolute">
    <parent link="base_link"/>
    <child  link="coxa_link_2"/>
    <origin xyz="-0.050 0.077 0.041" rpy="0 0 0"/>

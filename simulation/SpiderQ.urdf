        <box size="0.0402 0.012 0.0495"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.082 0.0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.0402 0.012 0.0495"/>
      </geometry>
    </collision>
    <inertial>

    </inertial>
  </link>

  <joint name="femur_joint_1" type="revolute">
    <parent link="coxa_link_1"/>
    <child  link="femur_link_1"/>
    <origin xyz="0.032 -0.008 -0.029" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="-1.5708" upper="1.5708" effort="1.8" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="femur_link_1">
    <visual>
      <origin xyz="0.080 0.0 0.0" rpy="0 -0.7854 0"/>
      <geometry>
        <box size="0.0402 0.012 0.0495"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0.080 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0402 0.012 0.0495"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.015"/>

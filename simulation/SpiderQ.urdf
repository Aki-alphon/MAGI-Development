<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpiderQ URDF
  Generated from SpiderQ.glb

  Robot Overview:
    - 4-legged quadruped spider robot
    - 3 DOF per leg: coxa (yaw), femur (pitch), tibia (pitch)
    - Total: 12 revolute joints (3 x 4 legs)
    - Actuators: MG90S micro servos

  Coordinate convention (GLB → URDF, all values in meters):
    GLB uses mm; divided by 1000 here.
  
  Leg numbering:
    Leg 0: front-left   (-X, -Z in GLB)
    Leg 1: front-right  (+X, -Z in GLB)
    Leg 2: rear-left    (-X, +Z in GLB)
    Leg 3: rear-right   (+X, +Z in GLB)
-->

<robot name="SpiderQ">

  <!-- =========================================================
       MATERIALS
  ========================================================= -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="servo_blue">
    <color rgba="0.1 0.3 0.7 1.0"/>
  </material>

  <!-- =========================================================
       BASE LINK  (world-fixed body)
       GLB body extras: x=121mm, y=75.75mm, z=98mm
       body pivot at origin; base mesh offset y=+92mm, basec y=+120mm
  ========================================================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.092 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1185 0.035 0.098"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- cover plate slightly higher -->
    <visual>
      <origin xyz="0.0 0.120 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.121 0.029 0.079"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.106 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.121 0.064 0.098"/>
      </geometry>
    </collision>
    <inertial>
      <!-- ~150 g body estimate -->
      <mass value="0.150"/>
      <origin xyz="0.0 0.106 0.0" rpy="0 0 0"/>
      <inertia ixx="3.0e-4" ixy="0" ixz="0"
               iyy="2.0e-4" iyz="0"
               izz="3.5e-4"/>
    </inertial>
  </link>

  <!-- ==========================================================
       LEG MACRO — repeated 4 times with mirrored origins
       
       Pivot positions from GLB (mm → m):
         Leg0:  coxa0-pivot  (-0.050,  0.077, -0.041)
         Leg1:  coxa1-pivot  ( 0.050,  0.077, -0.041)
         Leg2:  coxa2-pivot  (-0.050,  0.077,  0.041)
         Leg3:  coxa3-pivot  ( 0.050,  0.077,  0.041)

       Within each leg (relative to coxa pivot):
         femur0-pivot offset:  (-0.030, -0.008, -0.028) for leg0
         tibia0-pivot offset:  (-0.010, -0.005, -0.011) rel to femur-pivot

       Link sizes (from extras, mm → m):
         coxapart:  18.3 x 36.0 x 37.5  mm
         femurpart: 40.2 x 49.5 x 12.0  mm
         tibiapart: 18.3 x 16.5 x 100.3 mm
         mg90s servo: 33 x 12.5 x 32.5  mm
  ========================================================== -->

  <!-- ===========================================================
       LEG 0  —  Front-Left   coxa-pivot at (-0.050, 0.077, -0.041)
  =========================================================== -->

  <!-- COXA joint 0 -->
  <joint name="coxa_joint_0" type="revolute">
    <parent link="base_link"/>
    <child  link="coxa_link_0"/>
    <origin xyz="-0.050 0.077 -0.041" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>   <!-- yaw about vertical -->
    <limit  lower="-1.5708" upper="1.5708" effort="1.8" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="coxa_link_0">
    <visual>
      <!-- coxapart: 18.3 x 36 x 37.5 mm, local offset (-0.006, 0, -0.009) -->
      <origin xyz="-0.006 0.0 -0.009" rpy="0.7854 0 0"/>
      <geometry>
        <box size="0.0183 0.036 0.0375"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.006 0.0 -0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.0183 0.036 0.0375"/>
      </geometry>
    </collision>
    <inertial>
      <!-- ~8 g coxa bracket -->
      <mass value="0.008"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.0e-6" ixy="0" ixz="0"
               iyy="1.0e-6" iyz="0"
               izz="1.0e-6"/>
    </inertial>
  </link>

  <!-- FEMUR joint 0 -->
  <joint name="femur_joint_0" type="revolute">
    <parent link="coxa_link_0"/>
    <child  link="femur_link_0"/>
    <!-- femur0-pivot relative offset: (-0.030, -0.008, -0.028) -->
    <origin xyz="-0.030 -0.008 -0.028" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>   <!-- pitch about leg lateral -->
    <limit  lower="-1.5708" upper="1.5708" effort="1.8" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="femur_link_0">
    <visual>
      <!-- femurpart: 40.2 x 49.5 x 12 mm -->
      <origin xyz="-0.080 0.0 0.0" rpy="0 0.7854 0"/>
      <geometry>
        <box size="0.0402 0.012 0.0495"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.080 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0402 0.012 0.0495"/>
      </geometry>
    </collision>
    <inertial>
      <!-- ~15 g femur + servo -->
      <mass value="0.015"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.5e-6" ixy="0" ixz="0"
               iyy="1.5e-6" iyz="0"
               izz="1.5e-6"/>
    </inertial>
  </link>

  <!-- TIBIA joint 0 -->
  <joint name="tibia_joint_0" type="revolute">
    <parent link="femur_link_0"/>
    <child  link="tibia_link_0"/>
    <!-- tibia0-pivot relative to femur0-pivot: (-0.010, -0.0005, -0.011) -->
    <origin xyz="-0.010 -0.0005 -0.011" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="-2.0944" upper="0.1745" effort="1.8" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="tibia_link_0">
    <visual>
      <!-- tibiapart: 18.3 x 16.5 x 100.3 mm — long slender shin -->
      <origin xyz="-0.050 0.0 -0.020" rpy="0 0.7854 0"/>
      <geometry>
        <box size="0.0183 0.0165 0.1003"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.050 0.0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.0183 0.0165 0.1003"/>
      </geometry>
    </collision>
    <inertial>
      <!-- ~10 g tibia -->
      <mass value="0.010"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.0e-6" ixy="0" ixz="0"
               iyy="8.0e-6" iyz="0"
               izz="8.0e-6"/>
    </inertial>
  </link>

  <!-- Foot (fixed end-effector) -->
  <joint name="foot_joint_0" type="fixed">
    <parent link="tibia_link_0"/>
    <child  link="foot_link_0"/>
    <origin xyz="-0.090 0.0 -0.020" rpy="0 0 0"/>
  </joint>
  <link name="foot_link_0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.002"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>

  <!-- ===========================================================
       LEG 1  —  Front-Right   coxa-pivot at (0.050, 0.077, -0.041)
  =========================================================== -->

  <joint name="coxa_joint_1" type="revolute">
    <parent link="base_link"/>
    <child  link="coxa_link_1"/>
    <origin xyz="0.050 0.077 -0.041" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit  lower="-1.5708" upper="1.5708" effort="1.8" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="coxa_link_1">
    <visual>
      <origin xyz="0.006 0.0 -0.009" rpy="-0.7854 0 0"/>

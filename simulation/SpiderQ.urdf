    </inertial>
  </link>

  <joint name="tibia_joint_2" type="revolute">
    <parent link="femur_link_2"/>
    <child  link="tibia_link_2"/>
    <origin xyz="-0.040 -0.0005 0.030" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="-2.0944" upper="0.1745" effort="1.8" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="tibia_link_2">
    <visual>
      <origin xyz="-0.122 0.0 0.100" rpy="0 0.7854 0"/>
      <geometry>
        <box size="0.0183 0.0165 0.1003"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.122 0.0 0.100" rpy="0 0 0"/>
